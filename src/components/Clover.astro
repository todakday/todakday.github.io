---
// 전단지 타이틀 옆의 웃는 네잎클로버 마스코트. 장식용이라 스크린리더에서 숨김.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class:list={['clover', className]}
  viewBox="0 0 100 100"
  role="img"
  aria-hidden="true"
  focusable="false"
>
  <g class="leaf-group" stroke="#4f7a28" stroke-width="2.2" stroke-linejoin="round" fill="#79ab49">
    <path class="leaf" d="M50.0,46.0 C30.0,29.5 32.0,16.0 50.0,11.5 C68.0,16.0 70.0,29.5 50.0,46.0 Z" />
    <path class="leaf" d="M50.0,46.0 C66.5,26.0 80.0,28.0 84.5,46.0 C80.0,64.0 66.5,66.0 50.0,46.0 Z" />
    <path class="leaf" d="M50.0,46.0 C70.0,62.5 68.0,76.0 50.0,80.5 C32.0,76.0 30.0,62.5 50.0,46.0 Z" />
    <path class="leaf" d="M50.0,46.0 C33.5,66.0 20.0,64.0 15.5,46.0 C20.0,28.0 33.5,26.0 50.0,46.0 Z" />
  </g>
  <path d="M50,79 C48,85 52,90 49,97" fill="none" stroke="#557d2c" stroke-width="3.4" stroke-linecap="round" />
  <g stroke="#4f7a28" stroke-width="1.4" stroke-linecap="round" opacity="0.45" fill="none">
    <path d="M46.0,26.0 L52.0,18.0" /><path d="M54.0,28.0 L48.0,19.0" />
    <path d="M70.0,42.0 L78.0,48.0" /><path d="M68.0,50.0 L77.0,44.0" />
    <path d="M54.0,66.0 L48.0,74.0" /><path d="M46.0,64.0 L52.0,73.0" />
    <path d="M30.0,50.0 L22.0,44.0" /><path d="M32.0,42.0 L23.0,48.0" />
  </g>
  <g fill="#3a2f1f">
    <circle cx="43.5" cy="42.5" r="2.6" />
    <circle cx="57.5" cy="42.5" r="2.6" />
  </g>
  <path d="M42,49 C46,54.5 54,54.5 58,49" fill="none" stroke="#3a2f1f" stroke-width="2.4" stroke-linecap="round" />
</svg>

<style>
  .clover {
    width: 100%;
    height: 100%;
    transform-origin: 50% 82%;
    animation: sway 4.5s ease-in-out infinite;
  }

  @keyframes sway {
    0%,
    100% {
      transform: rotate(-4deg);
    }
    50% {
      transform: rotate(4deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .clover {
      animation: none;
    }
  }
</style>
