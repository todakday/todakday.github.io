---
import { cards } from '../data/service';
import InfoCard from './InfoCard.astro';
---

<section class="grid-wrap" aria-label="이용 안내">
  <div class="grid-clip">
    <div class="grid">
      {cards.map((card) => (
        <div class="cell">
          <InfoCard card={card} />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .grid-wrap {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.5rem 1.25rem 2.5rem;
  }

  /*
    원본 전단지의 초록 구분선 재현.

    모든 칸에 오른쪽·아래쪽 선을 그은 뒤, 격자 바깥으로 삐져나오는
    마지막 열의 오른쪽 선과 마지막 행의 아래쪽 선을 잘라내는 방식이다.
    열 수를 몰라도 되므로 브레이크포인트를 추가해도 선이 빠지지 않는다.
    (nth-child로 끝 칸의 선을 지우는 방식은 브레이크포인트마다 규칙이
     겹쳐서 특정 폭에서 선이 사라지는 문제가 있었다.)

    카드 6개는 3·2·1열 모두 나머지 없이 채워지므로 격자가 항상 직사각형이다.
  */
  .grid-clip {
    overflow: hidden;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    /* 바깥 테두리를 clip 영역 밖으로 밀어내 잘리게 한다 */
    margin-right: -2px;
    margin-bottom: -2px;
  }

  .cell {
    border-right: 2px solid var(--line);
    border-bottom: 2px solid var(--line);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
