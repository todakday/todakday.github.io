---
// 전단지의 알약형(구름 모양) 섹션 제목을 재현하는 컴포넌트.
interface Props {
  as?: 'h2' | 'h3';
  accent?: 'orange' | 'green' | 'red' | 'pink' | 'ink';
}

const { as: Tag = 'h2', accent = 'ink' }: Props = Astro.props;
---

<Tag class:list={['pill', `accent-${accent}`]}>
  <span class="dot dot-left" aria-hidden="true"></span>
  <span class="label"><slot /></span>
  <span class="dot dot-right" aria-hidden="true"></span>
</Tag>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 auto;
    padding: 0.5rem 1.5rem;
    background: var(--pill);
    border-radius: var(--radius-pill);
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1.3;
    white-space: nowrap;
  }

  .accent-orange {
    color: var(--orange);
  }
  .accent-green {
    color: var(--green-deep);
  }
  .accent-red {
    color: var(--red);
  }
  .accent-pink {
    color: var(--pink);
  }
  .accent-ink {
    color: var(--ink);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #fff9e6;
    flex-shrink: 0;
  }
</style>
